<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>E-KTP Berhasil Dibuat - E-KTP Generator Indonesia</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
        <div class="container">
            <a class="navbar-brand" href="/">
                <i class="bi bi-person-badge me-2"></i>E-KTP Generator
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="/"><i class="bi bi-house-door me-1"></i>Beranda</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="https://whatsapp.com/channel/0029VaoIOkS8aKvAjUsjNk1f" target="_blank"><i class="bi bi-whatsapp me-1"></i>Saluran WhatsApp</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container mt-4">
        <div class="row justify-content-center">
            <div class="col-md-10 col-lg-8">
                <div class="card shadow">
                    <div class="card-header">
                        <h2 class="text-center text-white mb-0"><i class="bi bi-check-circle me-2"></i>E-KTP Berhasil Dibuat</h2>
                    </div>
                    <div class="card-body text-center">
                        <div class="mb-4">
                            <div class="position-relative">
                                <img src="<%= imgPath %>" alt="E-KTP" class="img-fluid border" style="max-width: 100%;">
                                <div class="position-absolute bottom-0 end-0 m-3">
                                    <span class="badge bg-primary p-2"><i class="bi bi-info-circle me-1"></i>Hanya untuk Edukasi</span>
                                </div>
                            </div>
                        </div>

                        <!-- Info URL ImgBB -->
                        <% if (typeof imgPath !== 'undefined' && imgPath) { %>
                        <div class="mb-4">
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-link-45deg"></i></span>
                                <input type="text" class="form-control" id="imgbbUrl" value="<%= imgPath %>" readonly>
                                <button class="btn btn-outline-secondary" type="button" onclick="copyUrl()">
                                    <i class="bi bi-clipboard"></i> Copy
                                </button>
                            </div>
                            <small class="text-muted d-block mt-2">
                                <i class="bi bi-cloud-check me-1"></i>Gambar tersimpan permanen di ImgBB
                            </small>
                        </div>
                        <% } %>

                        <div class="mb-4 d-flex flex-column flex-md-row justify-content-center gap-2 flex-wrap">
                            <a href="<%= imgPath %>" download="ektp_<%= data.nama.replace(/\s+/g, '_').toLowerCase() %>.png" class="btn btn-primary">
                                <i class="bi bi-download me-2"></i>Download E-KTP
                            </a>
                            <a href="<%= imgPath %>" target="_blank" class="btn btn-info text-white">
                                <i class="bi bi-box-arrow-up-right me-2"></i>Buka di ImgBB
                            </a>
                            <% if (typeof deleteUrl !== 'undefined' && deleteUrl) { %>
                            <a href="<%= deleteUrl %>" target="_blank" class="btn btn-danger"
                               onclick="return confirm('Yakin ingin menghapus gambar dari ImgBB? Tindakan ini tidak bisa dibatalkan.')">
                                <i class="bi bi-trash me-2"></i>Hapus dari ImgBB
                            </a>
                            <% } %>
                            <a href="/" class="btn btn-secondary">
                                <i class="bi bi-plus-circle me-2"></i>Buat E-KTP Baru
                            </a>
                        </div>

                        <div class="alert alert-warning">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>
                            <strong>Catatan:</strong> E-KTP ini dibuat hanya untuk tujuan edukasi dan tidak memiliki nilai hukum. Dilarang menggunakan untuk tindakan penipuan atau melanggar hukum.
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <footer class="text-center py-3 mt-5">
        <div class="container">
            <p class="mb-0">Created by <a href="https://whatsapp.com/channel/0029VaoIOkS8aKvAjUsjNk1f" target="_blank">Mas Khan ID</a></p>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Script Copy URL -->
    <script>
        function copyUrl() {
            const input = document.getElementById('imgbbUrl');
            if (!input) return;
            input.select();
            input.setSelectionRange(0, 99999);
            navigator.clipboard.writeText(input.value)
                .then(() => {
                    const btn = event.target.closest('button');
                    const original = btn.innerHTML;
                    btn.innerHTML = '<i class="bi bi-check2"></i> Copied!';
                    btn.classList.remove('btn-outline-secondary');
                    btn.classList.add('btn-success');
                    setTimeout(() => {
                        btn.innerHTML = original;
                        btn.classList.remove('btn-success');
                        btn.classList.add('btn-outline-secondary');
                    }, 2000);
                })
                .catch(err => {
                    console.error('Gagal copy:', err);
                    alert('Gagal copy. Silakan copy manual.');
                });
        }
    </script>
</body>
</html>